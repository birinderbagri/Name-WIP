# --- Supabase (public: safe to expose to the browser) ---
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server only — NEVER exposed to the client) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Gemini (server only — NEVER exposed to the client) ---
# Free tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=...
# Model used for OCR + generation (must support vision for photo uploads)
GEMINI_MODEL=gemini-2.5-flash

# --- Ads (feature-flagged; leave off for local dev) ---
# Provider slot ids are only read when the matching feature flag is enabled.
PUBLIC_ADS_PROVIDER=placeholder
