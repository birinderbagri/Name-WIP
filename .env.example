# --- Supabase (public: safe to expose to the browser) ---
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server only — NEVER exposed to the client) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (server only — NEVER exposed to the client) ---
ANTHROPIC_API_KEY=sk-ant-...
# Model used for extraction + generation
ANTHROPIC_MODEL=claude-sonnet-5

# --- Ads (feature-flagged; leave off for local dev) ---
# Provider slot ids are only read when the matching feature flag is enabled.
PUBLIC_ADS_PROVIDER=placeholder
